<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gonzi Mini Pizza Artesanal</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Cores extraídas da Logo Gonzi */
            --primary: #E0C7AA; /* Bege/Dourado do texto e linhas */
            --secondary: #7A262E; /* Vinho/Bordô do fundo da logo */
            --dark: #252324; /* Chumbo/Preto da faixa central */
            --bg-light: #F9F9F9;
            --white: #FFFFFF;
        }

        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
            font-family: 'Montserrat', sans-serif; 
        }

        body { 
            background-color: var(--bg-light); 
            color: var(--dark); 
        }

        /* ----- HEADER ----- */
        header { 
            background-color: var(--secondary); 
            padding: 15px 5%; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            border-bottom: 4px solid var(--primary);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        header img { 
            max-height: 70px; 
            border-radius: 50%; 
            border: 2px solid var(--primary); 
            background-color: var(--secondary);
        }

        .btn { 
            background-color: var(--primary); 
            color: var(--dark); 
            padding: 10px 24px; 
            text-decoration: none; 
            font-weight: 700; 
            border-radius: 30px; 
            display: inline-block; 
            text-align: center; 
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
            filter: brightness(1.1);
        }

        .btn-large { 
            padding: 16px 32px; 
            font-size: 1.1rem; 
            margin-top: 30px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            gap: 12px; 
            width: 100%; 
            max-width: 320px; 
            margin-inline: auto; 
        }

        /* ----- HERO SECTION ----- */
        .hero { 
            background-color: var(--dark); 
            color: var(--white); 
            text-align: center; 
            padding: 80px 20px; 
            /* Textura de fundo sutil se quiser adicionar depois */
            background-image: radial-gradient(circle at center, #3a3739 0%, var(--dark) 100%);
        }

        .hero h1 { 
            color: var(--primary); 
            font-size: 2.5rem; 
            margin-bottom: 20px; 
            line-height: 1.2;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .hero p { 
            font-size: 1.15rem; 
            margin-bottom: 25px; 
            line-height: 1.6; 
            max-width: 600px;
            margin-inline: auto;
            color: #E8E8E8;
        }

        /* ----- DIFERENCIAIS ----- */
        .features { 
            padding: 70px 5%; 
            display: flex; 
            flex-direction: column; 
            gap: 30px; 
            align-items: center; 
        }

        .feature-card { 
            background: var(--white); 
            padding: 30px 20px; 
            border-radius: 12px; 
            box-shadow: 0 8px 15px rgba(0,0,0,0.05); 
            width: 100%; 
            max-width: 350px; 
            text-align: center; 
            border-top: 5px solid var(--secondary);
            transition: transform 0.3s;
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
        }

        .feature-card svg { 
            width: 50px; 
            height: 50px; 
            fill: var(--primary); 
            margin-bottom: 20px;
            background-color: var(--secondary);
            padding: 10px;
            border-radius: 50%;
        }

        .feature-card h3 { 
            color: var(--dark); 
            margin-bottom: 12px; 
            font-size: 1.3rem;
        }
        
        .feature-card p {
            color: #555;
            line-height: 1.5;
            font-size: 0.95rem;
        }

        /* ----- PROVA SOCIAL (Estilo Google) ----- */
        .reviews { 
            background-color: var(--secondary); 
            color: var(--white); 
            padding: 70px 5%; 
        }

        .reviews-title { 
            text-align: center; 
            color: var(--primary); 
            margin-bottom: 40px; 
            font-size: 2rem; 
        }

        .review-container { 
            display: flex; 
            flex-direction: column; 
            gap: 25px; 
            align-items: center; 
        }

        .review-card { 
            background: var(--white); 
            color: var(--dark); 
            padding: 25px; 
            border-radius: 12px; 
            width: 100%; 
            max-width: 400px; 
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

        .stars { 
            color: #FFB400; 
            font-size: 1.4rem; 
            margin-bottom: 12px; 
            letter-spacing: 2px;
        }
        
        .review-text {
            font-style: italic;
            color: #444;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .reviewer { 
            font-weight: 600; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            border-top: 1px solid #EEE;
            padding-top: 15px;
        }

        .google-icon { 
            width: 24px; 
            height: 24px; 
        }

        /* ----- FOOTER ----- */
        footer { 
            background-color: var(--dark); 
            color: var(--white); 
            text-align: center; 
            padding: 40px 20px; 
            border-top: 4px solid var(--primary); 
        }

        footer p { 
            margin-bottom: 10px; 
            line-height: 1.5;
        }
        
        .agency-brand {
            margin-top: 25px;
            font-size: 0.85rem;
            color: var(--primary);
            opacity: 0.8;
        }

        /* ----- RESPONSIVO ----- */
        @media (min-width: 768px) {
            .features, .review-container { 
                flex-direction: row; 
                justify-content: center; 
                flex-wrap: wrap; 
                align-items: stretch;
            }
            .hero h1 { font-size: 3.5rem; }
            .hero p { font-size: 1.3rem; }
        }
    </style>
</head>
<body>

    <header>
        <!-- A imagem da logo que você fará upload no GitHub -->
        <img src="logo.jpg" alt="Logo Gonzi Mini Pizza">
        <a href="#pedir" class="btn">Pedir Agora</a>
